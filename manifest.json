{
  "manifest_version": 3,
  "name": "SubFlix - Netflix Custom Subtitles",
  "version": "0.1.0",
  "description": "Load your own subtitle file (.srt/.vtt) and sync it over Netflix playback with real-time manual offset control.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "SubFlix"
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["*://*.netflix.com/*"],
  "content_scripts": [
    {
      "matches": ["*://*.netflix.com/*"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
